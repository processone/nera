{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nera check",
      "type": "process",
      "command": "${workspaceFolder}/../../../target/release/nera",
      "args": ["check"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "NO_COLOR": "1" }
      },
      "problemMatcher": {
        "owner": "nera",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^(error|warning): (.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*[┌╭]─ (.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "loop": true
          }
        ]
      }
    },
    {
      "label": "nera build",
      "type": "process",
      "command": "${workspaceFolder}/../../../target/release/nera",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "NO_COLOR": "1" }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "nera",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^(error|warning): (.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*[┌╭]─ (.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "loop": true
          }
        ]
      }
    },
    {
      "label": "nera run",
      "type": "process",
      "command": "${workspaceFolder}/../../../target/release/nera",
      "args": ["run"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "NO_COLOR": "1" }
      },
      "problemMatcher": {
        "owner": "nera",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^(error|warning): (.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*[┌╭]─ (.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "loop": true
          }
        ]
      }
    }
  ]
}
