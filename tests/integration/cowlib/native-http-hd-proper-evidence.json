  "core_source_diff": "diff --git a/crates/nera-ir/src/bif_table.rs b/crates/nera-ir/src/bif_table.rs\nindex bc3266e..8637ef5 100644\n--- a/crates/nera-ir/src/bif_table.rs\n+++ b/crates/nera-ir/src/bif_table.rs\n@@ -47,6 +47,7 @@ pub const BIF_TABLE: &[BifEntry] = &[\n     // erlang module \u2014 arithmetic\n     // -------------------------------------------------------------------------\n     BifEntry { module: \"erlang\", function: \"abs\",   arity: 1, ffi_symbol: Some(\"nera_rt_abs\"), auto_import: true, param_names: None, spec: Some(\"-spec abs(Float) -> float(); (Int) -> non_neg_integer().\") },\n+    BifEntry { module: \"math\", function: \"sqrt\", arity: 1, ffi_symbol: Some(\"nera_rt_math_sqrt\"), auto_import: false, param_names: Some(&[\"Number\"]), spec: Some(\"-spec sqrt(Number :: number()) -> float().\") },\n     BifEntry { module: \"erlang\", function: \"round\", arity: 1, ffi_symbol: Some(\"nera_rt_round\"), auto_import: true, param_names: None, spec: Some(\"-spec round(Number) -> integer().\") },\n     BifEntry { module: \"erlang\", function: \"trunc\", arity: 1, ffi_symbol: Some(\"nera_rt_trunc\"), auto_import: true, param_names: None, spec: Some(\"-spec trunc(Number) -> integer().\") },\n     BifEntry { module: \"erlang\", function: \"float\", arity: 1, ffi_symbol: Some(\"nera_rt_float\"), auto_import: true, param_names: None, spec: Some(\"-spec float(Number) -> float().\") },\ndiff --git a/crates/nera-runtime/src/ffi/apply.rs b/crates/nera-runtime/src/ffi/apply.rs\nindex 527ac1a..18c0b51 100644\n--- a/crates/nera-runtime/src/ffi/apply.rs\n+++ b/crates/nera-runtime/src/ffi/apply.rs\n@@ -143,6 +143,7 @@ pub(super) unsafe fn apply_impl(\n         (Some(\"erlang\"), Some(\"hd\"), 1) => Some(nera_rt_hd(ctx, arg_terms[0])),\n         (Some(\"erlang\"), Some(\"tl\"), 1) => Some(nera_rt_tl(ctx, arg_terms[0])),\n         (Some(\"erlang\"), Some(\"abs\"), 1) => Some(nera_rt_abs(ctx, arg_terms[0])),\n+        (Some(\"math\"), Some(\"sqrt\"), 1) => Some(super::arith::nera_rt_math_sqrt(ctx, arg_terms[0])),\n         (Some(\"erlang\"), Some(\"round\"), 1) => Some(nera_rt_round(ctx, arg_terms[0])),\n         (Some(\"erlang\"), Some(\"trunc\"), 1) => Some(nera_rt_trunc(ctx, arg_terms[0])),\n         (Some(\"erlang\"), Some(\"float\"), 1) => Some(nera_rt_float(ctx, arg_terms[0])),\ndiff --git a/crates/nera-runtime/src/ffi/arith.rs b/crates/nera-runtime/src/ffi/arith.rs\nindex 24c85ad..a9c9931 100644\n--- a/crates/nera-runtime/src/ffi/arith.rs\n+++ b/crates/nera-runtime/src/ffi/arith.rs\n@@ -7,6 +7,26 @@ use crate::term::ErlTerm;\n use crate::atom_table::{ATOM_TRUE, ATOM_FALSE};\n use super::helpers::*;\n \n+/// math:sqrt/1 \u2014 finite nonnegative numbers, coerced to an Erlang float.\n+///\n+/// # Safety\n+/// The context must be live and exclusively accessible, with a valid process\n+/// heap. Boxed input storage must remain live and unmoved for this call.\n+#[no_mangle]\n+pub unsafe extern \"C\" fn nera_rt_math_sqrt(ctx: *mut ProcessContext, value: u64) -> u64 {\n+    let term = ErlTerm(value);\n+    if !is_numeric(term) {\n+        return raise_badarg(ctx);\n+    }\n+    let Some(number) = extract_numeric(term) else {\n+        return raise_badarith(ctx);\n+    };\n+    if !number.is_finite() || number < 0.0 {\n+        return raise_badarith(ctx);\n+    }\n+    with_ctx_heap(ctx, |heap| heap.alloc_float(number.sqrt()).0)\n+}\n+\n /// Arithmetic add: int+int -> int, float+float -> float, int+float / float+int -> float.\n #[no_mangle]\n pub unsafe extern \"C\" fn nera_rt_add(ctx: *mut ProcessContext, a: u64, b: u64) -> u64 {\n",
