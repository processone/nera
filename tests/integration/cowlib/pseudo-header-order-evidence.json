  "scope": "136 project-owned cow_http cases on unchanged external Cowlib. Correction is to the comparison contract, not Nera runtime behavior or Cowlib implementation.",
  "diagnosis": "Cowlib folds over maps:to_list/1, whose order is undefined. The strict comparator treated a permutation of distinct leading pseudo-header fields as a compiler mismatch. Both engines preserve the same names/values.",
  "sources": [
    {
      "url": "https://www.erlang.org/doc/apps/stdlib/maps.html#to_list/1",
      "contract": "Map enumeration order is undefined without an ordered iterator."
    },
    {
      "url": "https://www.rfc-editor.org/rfc/rfc9113.html#section-8.3",
      "contract": "All pseudo-header fields precede regular fields; duplicates are invalid. Relative pseudo-header order is not prescribed."
    }
  ],
  "comparison_contract": {
    "mode": "request_pseudo_headers",
    "opt_in_cases": [
      "http_merge_request"
    ],
    "canonicalized": "Only the leading request pseudo-header prefix; exact name/value bytes are retained.",
    "rejected": "Duplicate/unknown pseudo-header names, pseudo-header after regular fields, malformed pairs, non-binary names/values and exception outcomes.",
    "preserved": "Ordinary suffix order, repeated ordinary fields and all field bytes. Other corpus cases retain exact comparison.",
    "raw_results_preserved": true,
    "wire_equal_for_fixed_case": false
  },
